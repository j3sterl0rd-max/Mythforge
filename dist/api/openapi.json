{
  "openapi": "3.1.0",
  "info": {
    "title": "Mythforge public content API",
    "version": "1.0.0",
    "description": "Read-only access to published website pages as HTML or Markdown. No accounts, payments, server administration, or live game-status API is provided.",
    "contact": {
      "email": "admin@mythforge.win"
    }
  },
  "servers": [
    {
      "url": "https://mythforge.win"
    }
  ],
  "paths": {
    "/beta-testers/": {
      "get": {
        "summary": "Read beta-testers page",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "Use text/markdown for clean main content; HTML is the default.",
            "schema": {
              "type": "string",
              "default": "text/html"
            },
            "example": "text/markdown"
          }
        ],
        "responses": {
          "200": {
            "description": "Published page in the requested representation.",
            "headers": {
              "Vary": {
                "schema": {
                  "type": "string"
                },
                "description": "Includes Accept to separate HTML and Markdown cache variants."
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "Read representation headers without a response body",
        "responses": {
          "200": {
            "description": "Same representation headers as GET; no body."
          }
        }
      }
    },
